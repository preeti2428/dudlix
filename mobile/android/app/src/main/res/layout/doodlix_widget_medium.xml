<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_lavender"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- Left Canvas Drawing Box -->
    <FrameLayout
        android:layout_width="120dp"
        android:layout_height="match_parent"
        android:background="@drawable/canvas_card_bg"
        android:padding="4dp">

        <ImageView
            android:id="@+id/widget_drawing_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Shared Drawing Preview"
            android:scaleType="fitCenter" />
    </FrameLayout>

    <!-- Right Side Information & Action Button -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <!-- Friend Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_friend_initials"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/circle_avatar_bg_purple"
                android:gravity="center"
                android:text="TB"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_friend_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Taylor (Person B)"
                android:textColor="#24213A"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_last_updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Synced just now"
            android:textColor="#6B6882"
            android:textSize="10sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Tap to Open Button -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/pill_button_purple"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="✏️ Open Canvas"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>

